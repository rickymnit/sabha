# Web app build settings. Copy to apps/web/.env.local for `pnpm dev`; pass as --build-arg to the image build.
# Vite puts these into the browser bundle, so they must never hold secrets. Setup: docs/setup/auth.md.

# Issuer URL of the identity provider (Auth0, docs/adr/0002-auth.md). Same value as the API's OIDC_ISSUER.
VITE_OIDC_AUTHORITY=
# Client id of the Single Page Application in the provider (PKCE, no client secret). The API's OIDC_CLIENT_ID.
VITE_OIDC_CLIENT_ID=
# The API identifier access tokens must carry. Same value as the API's OIDC_AUDIENCE.
VITE_OIDC_AUDIENCE=
