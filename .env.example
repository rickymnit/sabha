# Sabha environment settings.
#
# Copy to .env for local development (.env is gitignored) and fill in the blanks. In staging and production
# these come from the deployment's secret store, never from a committed file.
# Loaded and validated by packages/core/sabha_core/settings.py; check with `uv run python scripts/check_env.py`.
#
# REQUIRED values are marked. An empty value (KEY=) counts as unset.
# Golden rule 12: staging and production must use ap-south-1; the app refuses to start otherwise.

# --- Application -------------------------------------------------------------------------------------------
# REQUIRED. One of: local, test, staging, production
APP_ENV=local
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# Browser origins allowed to call the API, comma-separated, no paths.
CORS_ORIGINS=http://localhost:5180
# Optional. Commit the running code was built from (the API image sets it); shown by GET /v1/meta.
GIT_SHA=

# --- MongoDB -----------------------------------------------------------------------------------------------
# REQUIRED. Must be a replica set (transactions and change streams). Local: ?replicaSet=rs0.
# Atlas (Mumbai): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/   (SECRET: contains a password)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=sabha

# --- Redis -------------------------------------------------------------------------------------------------
# REQUIRED. Celery broker. redis:// or rediss:// (TLS). SECRET if it contains a password.
# Local dev Redis (infra/docker-compose.dev.yml) listens on 6380, not 6379.
REDIS_URL=redis://localhost:6380/0

# --- API rate limits ---------------------------------------------------------------------------------------
# Optional. Requests per minute for a whole tenant and for one user; a burst may reach BURST_FACTOR times that
# before the API answers 429. Defaults: 600, 120, 1.5.
RATE_LIMIT_TENANT_PER_MINUTE=
RATE_LIMIT_USER_PER_MINUTE=
RATE_LIMIT_BURST_FACTOR=

# --- Object storage (S3 on AWS, RustFS locally) ------------------------------------------------------------
# REQUIRED. Three buckets per environment, each with its own lifecycle (docs/setup/cloud-checklist.md).
S3_BUCKET_AUDIO=sabha-audio
S3_BUCKET_ARTEFACTS=sabha-artefacts
S3_BUCKET_BACKUPS=sabha-backups
# Must be ap-south-1 in staging and production.
S3_REGION=ap-south-1
# Local RustFS only. Leave empty on AWS; the app refuses it in staging and production.
S3_ENDPOINT_URL=http://localhost:9000
# Local RustFS only: `make env` fills both with random values the first time. On AWS leave both empty: the app
# uses its IAM role. SECRET.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Uploads ------------------------------------------------------------------------------------------------
# Optional. Browsers upload straight to the audio bucket with presigned multipart URLs (golden rule 2).
# UPLOAD_MAX_BYTES=1073741824
# UPLOAD_PART_SIZE_BYTES=16777216
# UPLOAD_URL_EXPIRY_S=900

# --- Authentication (OIDC) ---------------------------------------------------------------------------------
# REQUIRED. Issuer URL of the Auth0 tenant, e.g. https://sabha-dev.eu.auth0.com/ (docs/setup/auth.md). https outside local.
OIDC_ISSUER=
# REQUIRED. The API audience that access tokens must carry.
OIDC_AUDIENCE=
# REQUIRED. Public client id of the web app (PKCE, no client secret).
OIDC_CLIENT_ID=

# --- Observability -----------------------------------------------------------------------------------------
# Optional. OTLP/HTTP collector base URL, e.g. http://localhost:4318; tracing is off when empty. The collector and
# its backend must keep data in India (golden rule 12).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional. Error reporting. SECRET. Check where the Sentry project stores data before enabling (golden rule 12).
SENTRY_DSN=
# Optional. LLM tracing. Set host and both keys, or none. Self-host in ap-south-1 unless approved otherwise.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
# SECRET.
LANGFUSE_SECRET_KEY=

# --- Speech recognition (ASR) -----------------------------------------------------------------------------
# docs/adr/0006-asr-sarvam.md. The speech worker refuses to start without a provider.
# "sarvam" in staging and production; "fake" (canned words, no network) only for tests and local development.
ASR_PROVIDER=
# Optional. Comma-separated providers to try, in order, when the main one fails. Empty means no fallback: a failure
# fails the stage. Every fallback use is logged with its reason (golden rule 7).
ASR_FALLBACKS=
# Optional. The provider's model; empty uses its default (Sarvam: saaras:v4).
ASR_MODEL=
# Optional. BCP-47 language hint such as hi-IN or en-IN; "unknown" (the default) detects it, including Hindi-English
# switching.
ASR_LANGUAGE=unknown
# Sarvam AI API key. SECRET. Do not use it with real recordings until Sarvam's retention and training terms are
# confirmed in writing (ADR 0006).
SARVAM_API_KEY=
# Optional. Sarvam's API base URL; https outside local.
SARVAM_BASE_URL=https://api.sarvam.ai

# --- LLM providers -----------------------------------------------------------------------------------------
# One block per provider, all optional, added once providers are chosen (docs/llm-providers.md, plan task 0.6).
# Every provider must be approved for data residency first (golden rule 12). Keys are SECRET.
# Do not put a key here for staging or production until the provider's data-residency terms are confirmed in
# writing (docs/llm-providers.md) and the lawyer has answered docs/legal/drafts/questions-for-lawyer.md, group E.

# LLM gateway (P5.1). Optional; defaults shown. Models are "<provider>:<model>". Fallbacks are per task, JSON, and
# used only when listed (golden rule 7). Budgets are tokens per UTC day; empty means no limit.
# LLM_MODEL_SMALL=openai:gpt-6-luna
# LLM_MODEL_MID=openai:gpt-6-luna
# LLM_FALLBACKS={}
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=3
LLM_TENANT_DAILY_TOKEN_BUDGET=
LLM_GLOBAL_DAILY_TOKEN_BUDGET=

# OpenAI (chosen 2026-10-16). Use an API key of a dedicated Sabha project, not a personal ChatGPT login. SECRET.
OPENAI_API_KEY=
# Optional. Only for a regional endpoint that matches the approved data residency; empty uses OpenAI's default.
OPENAI_BASE_URL=

# --- Email (Amazon SES) ------------------------------------------------------------------------------------
# Must be ap-south-1 in staging and production.
SES_REGION=ap-south-1
# Optional until notifications ship. A verified sender address, e.g. no-reply@<your domain>.
SES_SENDER=
# Optional. Where links in emails point (the web app); http://localhost:5180 in development.
# WEB_BASE_URL=https://app.example.in

# --- Speech workers ----------------------------------------------------------------------------------------
# Optional. CUDA device index for the gpu.speech worker; leave empty on CPU-only machines.
GPU_DEVICE_ID=

# Optional, local development only: a built-in sign-in while Auth0 is not set up (refused unless APP_ENV=local).
# With it set OIDC_ISSUER=http://localhost:8000/dev-idp, OIDC_AUDIENCE=sabha-local, OIDC_CLIENT_ID=sabha-web, then run
# `uv run python scripts/admin/dev_seed.py` for a demo school whose users appear on the web app's sign-in page.
# DEV_LOGIN=false

# Optional. Folder of rubric files (<rubric id>.yaml); default "rubrics" (the repo's folder). Images set /app/rubrics.
# RUBRICS_DIR=rubrics

# Speaker diarization (P3.4): pyannote on CPU now, `cuda` once there is a GPU. Install with `make setup-speech`.
# DIARIZER=pyannote
# DIARIZATION_DEVICE=cpu
# DIARIZATION_BATCH_SIZE=8  # larger uses more memory; try 32 on a GPU
# DIARIZATION_MODEL_DIR=   # default ~/.cache/sabha/models/pyannote-community-1-<revision>
# Hugging Face read token. SECRET. Only to download the pyannote model (`make models-speech`) after accepting its
# conditions on huggingface.co; never used while processing recordings.
HF_TOKEN=

# Optional. Voice activity detection (preprocess). Defaults shown; unmeasured, tune on the gold set.
# VAD_MODEL_PATH=          # default ~/.cache/sabha/models/silero_vad-<version>.onnx, fetched by `make models`
# VAD_THRESHOLD=0.5
# VAD_MIN_SPEECH_MS=250
# VAD_MIN_SILENCE_MS=100
# VAD_END_PAD_MS=300
# VAD_MERGE_GAP_MS=1500

# --- Artefact versions -------------------------------------------------------------------------------------
# Part of every artefact path: {tenant_id}/{recording_id}/{stage}@{version}/. Bump one to recompute that
# stage instead of reusing stored output. Letters, digits, '.', '_' and '-' only.
ARTEFACT_VERSION_PREPROCESS=v1
ARTEFACT_VERSION_DIARIZE=v1
ARTEFACT_VERSION_TRANSCRIBE=v1
ARTEFACT_VERSION_ANALYZE=v1
