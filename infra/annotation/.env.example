# Copy to .env in this folder (gitignored), fill in, then: chmod 600 .env
# Docker Compose reads .env from this folder automatically. Never commit the real .env.

# Admin account created on first start. Must be an email address. Pick a long, unique password
# (8-128 characters); it is only used to create the account, so changing it here later does NOT
# change the password of an existing account (use the Label Studio UI for that).
LABEL_STUDIO_USERNAME=
LABEL_STUDIO_PASSWORD=

# Folder on this machine that holds the recordings to annotate. It is mounted read-only into
# Label Studio at /label-studio/files/audio. Absolute path, or relative to this folder
# (for example ../../eval/goldset/audio, which is gitignored). It must already exist.
ANNOTATION_AUDIO_DIR=

# Optional. Where Label Studio listens on this machine. Blank means 127.0.0.1 and 8080.
# Read infra/annotation/README.md before using anything other than 127.0.0.1.
ANNOTATION_BIND_ADDR=
ANNOTATION_PORT=
