{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabha.local/schemas/analysis.v1.schema.json",
  "title": "Sabha analysis report (analysis@v1)",
  "description": "Written by sabha_analytics.report. Rules JSON Schema cannot express are enforced in code by report.check_report: an unverified dimension has no score, rationale or evidence; every evidence quote is the transcript's own (redacted) wording at that utterance's original-timeline times; every suggestion points at a transcript utterance; no overall score means next_status NEEDS_REVIEW.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rubric", "transcript", "overall", "dimensions", "metrics", "synthesis", "next_status",
               "review_reasons", "model_ids", "prompts", "usage"],
  "properties": {
    "version": {"const": "analysis@v1"},
    "rubric": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}}
    },
    "transcript": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "asr_model"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "asr_model": {"type": "string"}}
    },
    "overall": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "verified_share", "verified_weight", "total_weight"],
      "properties": {
        "score": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
        "verified_share": {"type": "number", "minimum": 0, "maximum": 1},
        "verified_weight": {"type": "number", "minimum": 0},
        "total_weight": {"type": "number", "minimum": 0}
      }
    },
    "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object", "required": ["key", "value", "unit", "definition"],
        "properties": {"key": {"type": "string"}, "unit": {"type": "string"}, "definition": {"type": "string"}}
      }
    },
    "synthesis": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/synthesis"}]},
    "next_status": {"enum": ["COMPLETED", "NEEDS_REVIEW"]},
    "review_reasons": {"type": "array", "items": {"enum": ["low_verification", "synthesis_failed", "uncertain_type", "ticket_failed"]}},
    "classification": {
      "oneOf": [{"type": "null"}, {
        "type": "object", "additionalProperties": false, "required": ["type", "language_mix", "confidence"],
        "properties": {"type": {"type": ["string", "null"]}, "language_mix": {"enum": ["english", "hindi", "hinglish", null]},
                       "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
      }]
    },
    "phases": {
      "oneOf": [{"type": "null"}, {"type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "start_utterance_id", "end_utterance_id", "start_ms", "end_ms"],
        "properties": {"phase": {"type": "string"}, "start_utterance_id": {"type": "string", "pattern": "^u[0-9]{4,}$"},
                       "end_utterance_id": {"type": "string", "pattern": "^u[0-9]{4,}$"},
                       "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}}
      }}]
    },
    "ticket": {
      "oneOf": [{"type": "null"}, {
        "type": "object", "additionalProperties": false, "required": ["category", "status", "follow_up", "summary"],
        "properties": {
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "description": "One of the rubric's output_values.category."},
          "status": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "description": "One of the rubric's output_values.status."},
          "follow_up": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
            "required": ["text", "owner_role"], "properties": {"text": {"type": "string"}, "owner_role": {"type": "string"}}}]},
          "summary": {"type": "string", "minLength": 1}
        }
      }]
    },
    "deal_card": {
      "description": "Sales meetings only: the deal card, verified items only (sabha_analytics.sales).",
      "oneOf": [{"type": "null"}, {
        "type": "object", "additionalProperties": false,
        "required": ["current_setup", "customer_needs", "objections", "interest_level", "next_step", "left_out"],
        "properties": {
          "current_setup": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false,
            "required": ["fact", "evidence"], "properties": {"fact": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/card_evidence"}}}},
          "customer_needs": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false,
            "required": ["need", "evidence"], "properties": {"need": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/card_evidence"}}}},
          "objections": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false,
            "required": ["objection", "response", "settled", "evidence"],
            "properties": {"objection": {"type": "string", "minLength": 1}, "response": {"type": "string", "minLength": 1},
                           "settled": {"enum": ["yes", "no", "unclear"]}, "evidence": {"$ref": "#/$defs/card_evidence"}}}},
          "interest_level": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["value", "evidence"],
            "properties": {"value": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "description": "One of the rubric's output_values.interest_level."},
                           "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/card_evidence"}]}}}]},
          "next_step": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["action", "owner", "due", "evidence"],
            "properties": {"action": {"type": "string", "minLength": 1}, "owner": {"enum": ["sales_rep", "customer", "both"]},
                           "due": {"type": ["string", "null"]}, "evidence": {"$ref": "#/$defs/card_evidence"}}}]},
          "left_out": {"type": "integer", "minimum": 0, "description": "Items left out because their quote was not found in the transcript."}
        }
      }]
    },
    "meeting_notes": {
      "description": "Meetings only: decisions, action items and open questions, verified items only (sabha_analytics.meetings).",
      "oneOf": [{"type": "null"}, {
        "type": "object", "additionalProperties": false, "required": ["decisions", "action_items", "open_questions", "left_out"],
        "properties": {
          "decisions": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false,
            "required": ["decision", "evidence"], "properties": {"decision": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/card_evidence"}}}},
          "action_items": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false,
            "required": ["action", "owner", "owner_voice", "due", "evidence"],
            "properties": {"action": {"type": "string", "minLength": 1}, "owner": {"type": ["string", "null"]},
                           "owner_voice": {"type": ["string", "null"]}, "due": {"type": ["string", "null"]},
                           "evidence": {"$ref": "#/$defs/card_evidence"}}}},
          "open_questions": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false,
            "required": ["question", "evidence"], "properties": {"question": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/card_evidence"}}}},
          "left_out": {"type": "integer", "minimum": 0, "description": "Items left out because their quote was not found in the transcript."}
        }
      }]
    },
    "model_ids": {"type": "array", "items": {"type": "string"}},
    "prompts": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["version", "sha256"],
        "properties": {"version": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "usage": {"type": "object", "required": ["total", "calls"]}
  },
  "$defs": {
    "card_evidence": {
      "type": "object", "additionalProperties": false, "required": ["quote", "utterance_id", "start_ms", "end_ms"],
      "properties": {"quote": {"type": "string", "minLength": 1}, "utterance_id": {"type": "string", "pattern": "^u[0-9]{4,}$"},
                     "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["quote", "utterance_id", "start_ms", "end_ms"],
      "properties": {
        "quote": {"type": "string", "minLength": 1},
        "utterance_id": {"type": "string", "pattern": "^u[0-9]{4,}$"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1}
      }
    },
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name", "weight", "verified", "attempts", "grounding", "score", "rationale", "evidence",
                   "failure_reasons"],
      "properties": {
        "key": {"type": "string"},
        "name": {"type": "string"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "verified": {"type": "boolean"},
        "not_applicable": {
          "const": true,
          "description": "Present only when the dimension was verified as not applying to this conversation (rubric not_applicable_when): no score, left out of the overall score; the rationale and evidence say why."
        },
        "attempts": {"type": "integer", "minimum": 1, "maximum": 2},
        "grounding": {
          "type": "object", "additionalProperties": false, "required": ["quotes_offered", "quotes_verified"],
          "properties": {"quotes_offered": {"type": "integer", "minimum": 0}, "quotes_verified": {"type": "integer", "minimum": 0}}
        },
        "score": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "rationale": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "failure_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "synthesis": {
      "type": "object", "additionalProperties": false, "required": ["summary", "strengths", "gaps", "suggestions"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "strengths": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "string"}},
        "gaps": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "string"}},
        "suggestions": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["text", "utterance_id", "start_ms", "end_ms"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "utterance_id": {"type": "string", "pattern": "^u[0-9]{4,}$"},
              "start_ms": {"type": "integer", "minimum": 0},
              "end_ms": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
